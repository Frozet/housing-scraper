# По умолчанию интерфейс доступен только на этом компьютере.
WEB_PORT=8088
POSTGRES_PASSWORD=avito_local_only
# Пауза перед каждым запросом. Минимум — 1 секунда.
REQUEST_DELAY_SECONDS=5
REQUEST_TIMEOUT_SECONDS=30
# 0 — обход всех страниц / объявлений, пока они доступны.
MAX_PAGES=0
MAX_LISTINGS=0
# Необязательный собственный HTTP CONNECT или SOCKS5-прокси.
# Например: http://USER:PASSWORD@HOST:PORT или socks5h://USER:PASSWORD@HOST:PORT
AVITO_PROXY_URL=
# По умолчанию сбор работает без прокси, регистрации и внешней подписки.
AVITO_PROXY_REQUIRED=false
# Бесплатный локальный браузер с ручным прохождением CAPTCHA.
COLLECTOR_MODE=browser
BROWSER_WAIT_SECONDS=300
